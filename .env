MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=meeting-recordings

NODE_ENV=production
MAX_RECORDING_DURATION_MINUTES=60
REDIS_CONSUMER_ENABLED=false
UPLOADER_FILE_EXTENSION=.webm
JOIN_WAIT_TIME_MINUTES=2
RETRY_COUNT=1
LOCAL_RECORDING_QUALITY=1080p
LOCAL_RECORDINGS_HOST_DIR=./recordings
LOCAL_RECORDINGS_DIR=/recordings
S3_REGION=us-west-2

MEETING_BOT_BEARER_TOKEN=local-dev-token
